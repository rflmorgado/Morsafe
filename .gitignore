.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# credenciais — senhas e chaves de serviços (Supabase, Asaas, etc.),
# guardadas em texto só pra consulta local. Nunca commitar.
/credenciais/
